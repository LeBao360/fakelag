<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_dock"
    android:clickable="true"
    android:elevation="12dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- Nút TELEPORT (Flash Lag) -->
    <FrameLayout
        android:id="@+id/btnFloatingTele"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_circle_tele"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/teleContentNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="TELE"
                android:src="@drawable/bi_lightning_charge_fill" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TELE"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTeleCountdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="0.8s"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Nút FAKE LAG / DAME -->
    <FrameLayout
        android:id="@+id/btnFloatingLag"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_circle_lag"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/lagContentNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivLagPlayIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="LAG"
                android:src="@drawable/bi_controller" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LAG"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLagCountdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1.5s"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Nút Mở Menu / Thu nhỏ -->
    <FrameLayout
        android:id="@+id/btnFloatingMenuToggle"
        android:layout_width="38dp"
        android:layout_height="54dp"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Menu"
            android:src="@drawable/bi_gear_fill" />
    </FrameLayout>

</LinearLayout>
